BOT_TOKEN=
OWNER_ID=
WEBHOOK_SECRET=
APP_URL=https://your-project.vercel.app
# Local: place the real key in .env.local (ignored by Git).
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Auto-enabled when a key is present. Set false to use rules only.
AI_PARSING_ENABLED=
# Counts remain bounded by the actual pinned message size.
MAX_CHANNELS=100
MAX_SECTIONS=50
POST_LOG_LIMIT=12
UPDATE_LOG_LIMIT=16
ATTEMPT_LOG_LIMIT=12
MAX_HELD_POSTS=2
DUPLICATE_WINDOW_HOURS=24
